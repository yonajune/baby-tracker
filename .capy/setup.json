{
  "$schema": "https://api.capy.ai/schemas/setup.v1.json",
  "format_version": 1,
  "scripts": {
    "initialize": "bash scripts/setup.sh initialize",
    "refresh": "bash scripts/setup.sh refresh"
  },
  "startup": [
    {
      "name": "dev",
      "command": "npm run dev -- --host 0.0.0.0 --port 5173 --strictPort",
      "port": 5173,
      "timeout": 60
    }
  ],
  "commands": [
    { "name": "lint", "command": "npm run lint" },
    { "name": "typecheck", "command": "npm run typecheck" },
    { "name": "test", "command": "npm test" },
    { "name": "build", "command": "npm run build" },
    { "name": "preview", "command": "npm run preview -- --host 0.0.0.0 --port 4173 --strictPort", "port": 4173 }
  ]
}
